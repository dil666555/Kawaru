# 复制为 .env（gitignore）并填写，然后 chmod 600 .env。
# instant_support.load_env_file 自动加载；shell 里已导出的变量优先。
# 镜像 tag 不在此配置：留空默认用不可变的 sha-<当前 HEAD>（instant.local.json 的 image_tag 可覆盖）。

# 提交作业与 AssumeRole 的 RAM 用户 AccessKey（非主账号：主账号不能 AssumeRole）
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# INSTANT 拉取私有镜像的 ACR 凭证（与 GitHub Secrets 的 ACR_USERNAME/ACR_PASSWORD 相同）
ACR_PULL_USERNAME=
ACR_PULL_PASSWORD=

# 本机跳过 ECS 元数据凭证探测
ALIBABA_CLOUD_ECS_METADATA_DISABLED=true
